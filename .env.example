# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: expected `aud` claim on Supabase JWTs (default "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated

# Proxmox — bare hostname or IP. Do NOT include scheme or port.
# (e.g. "172.17.10.1" or "proxmox.school.local", not "https://...:8006/")
# Port defaults to 8006; set PROXMOX_API_PORT only if non-standard.
PROXMOX_HOST=proxmox.school.local
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=briehost
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=pve
PHP_TEMPLATE_VMID=9000
# Comma-separated pool of equivalent PHP template VMIDs. The worker spawns one
# provisioning consumer per entry, so N templates = N parallel clones.
# Proxmox serializes full clones per source VMID, so duplicating the template
# (e.g. `pct clone 9000 9001 --full`) is what unlocks real concurrency.
# Falls back to PHP_TEMPLATE_VMID above if unset.
PHP_TEMPLATE_VMIDS=9000,9001

# Storage / limits
STORAGE_ROOT=/var/brieblast/clients
MAX_UPLOAD_BYTES=104857600

# Provisioning backend
PROVISIONER_BACKEND=ansible
ANSIBLE_PLAYBOOK_PATH=infra/ansible/playbooks/provision_site.yml
ANSIBLE_INVENTORY_PATH=infra/ansible/inventory/production.ini
ANSIBLE_EXTRA_VARS_JSON={}
ANSIBLE_TIMEOUT_SECONDS=1800
MAX_CONCURRENT_PROVISIONS=3

# Malware scanning + zip policy
ENABLE_MALWARE_SCAN=true
CLAMD_SOCKET=/run/clamav/clamd.ctl
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
MAX_ZIP_FILES=5000
MAX_ZIP_UNCOMPRESSED_BYTES=524288000
MAX_ZIP_COMPRESSION_RATIO=200

# CORS — comma-separated list of allowed dashboard origins
ALLOWED_ORIGINS=http://localhost:5173

# Runtime health checks for live sites. Public /status only counts sites with a
# recent passing check as online.
HEALTHCHECK_ENABLED=true
HEALTHCHECK_INTERVAL_SECONDS=60
HEALTHCHECK_TIMEOUT_SECONDS=5
HEALTHCHECK_MAX_CONCURRENCY=10
HEALTHCHECK_PUBLIC_SCHEME=https

# API bind settings
API_HOST=0.0.0.0
API_PORT=8000

# --- Payments (all sandbox / test mode) ---
# See docs/PAYMENTS.md. Each provider is optional; if a key is missing the
# corresponding /api/payments endpoint returns 503 instead of crashing.

# Public base URL the user is bounced back to after a hosted checkout.
# e.g. https://briehosting.be — the frontend handles /payment-return/:intentId
PAYMENTS_RETURN_BASE_URL=http://localhost:5173
# Public-internet URL where async-webhook providers (CoinGate) POST callbacks.
# Must be reachable from outside — e.g. https://api.briehosting.be
PAYMENTS_API_BASE_URL=http://localhost:8000

# Stripe (cards + Bancontact)
# Get keys at https://dashboard.stripe.com/test/apikeys (test mode toggle ON).
# The publishable key (pk_test_...) lives in the frontend, not here.
# Webhook secret comes from https://dashboard.stripe.com/test/webhooks after
# creating an endpoint pointing at https://<your-api>/api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (sandbox)
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# CoinGate (sandbox)
# Get a sandbox key at https://sandbox.coingate.com/ (separate signup from prod)
COINGATE_API_KEY=
COINGATE_API_BASE=https://api-sandbox.coingate.com/v2
COINGATE_WEBHOOK_SECRET=
